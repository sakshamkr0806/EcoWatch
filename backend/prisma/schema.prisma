generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
}

model User {
  id       String    @id @default(cuid())
  name     String?
  email    String    @unique
  password String    @map("password_hash")
  role     Role      @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stations Station[] @relation("UserStations")
}

model Station {
  id          String   @id @default(cuid())
  name        String
  type        StationType @default(AIR)
  location    String?
  isActive    Boolean  @default(true)

  userId      String?
  user        User?    @relation("UserStations", fields: [userId], references: [id])

  airReadings AirReading[]
  waterReadings WaterReading[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, isActive])
}

enum StationType {
  AIR
  WATER
  COMBINED
}

model AirReading {
  id          String    @id @default(cuid())
  stationId   String
  pm25        Float?
  pm10        Float?
  no2         Float?
  so2         Float?
  aqi         Int?
  dominant    String?
  recordedAt  DateTime  @default(now())

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, recordedAt])
}

model WaterReading {
  id          String   @id @default(cuid())
  stationId   String
  ph          Float?
  do_         Float?   @map("do")
  turbidity   Float?
  tds         Float?
  wqi         Int?
  recordedAt  DateTime @default(now())

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, recordedAt])
}

model Alert {
  id        String   @id @default(cuid())
  stationId String
  type      String
  severity  AlertSeverity
  message   String
  status    AlertStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stationId, status])
}

enum AlertStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}
